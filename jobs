#!/usr/bin/env bash
# Job Hunt Board launcher — self-bootstrapping so setup is one command.
#
# On first run (or if a dependency is missing) this creates a private Python
# environment in .venv/ and installs requirements, then runs the tool. You never
# have to touch pip or virtualenvs yourself.
#
#   ./jobs setup      ./jobs refresh      ./jobs open      ./jobs doctor
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
VENV="$DIR/.venv"
PY="$VENV/bin/python"

find_python() {
  for c in python3.13 python3.12 python3.11 python3.10 python3; do
    if command -v "$c" >/dev/null 2>&1 \
      && "$c" -c 'import sys; raise SystemExit(sys.version_info < (3, 10))' 2>/dev/null; then
      echo "$c"
      return 0
    fi
  done
  return 1
}

needs_bootstrap() {
  [ ! -x "$PY" ] && return 0
  "$PY" -c "import requests" >/dev/null 2>&1 || return 0
  return 1
}

if needs_bootstrap; then
  SYS_PY="$(find_python)" || {
    echo "✗ Python 3 is not installed. Install it from https://www.python.org/downloads/ (or 'brew install python'), then run ./jobs setup again." >&2
    exit 1
  }
  echo "First-time setup: creating a private Python environment (one-time, ~20s)…"
  if [ ! -x "$PY" ]; then
    "$SYS_PY" -m venv "$VENV" || {
      echo "✗ Could not create the Python environment. Make sure Python 3.10+ is installed, then retry." >&2
      exit 1
    }
  fi
  "$PY" -m pip install -q --no-cache-dir --upgrade pip >/dev/null 2>&1 || true
  if ! "$PY" -m pip install -q --no-cache-dir -r "$DIR/requirements.txt" 2>/dev/null; then
    echo "✗ Could not install dependencies. Check your internet connection and retry ./jobs setup." >&2
    exit 1
  fi
  echo "✓ Environment ready."
fi

exec "$PY" "$DIR/jobs.py" "$@"
